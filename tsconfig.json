{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests"],
  // Route fixtures are loaded by analyze-routes.test.ts via its own program.
  // They trip declaration-emit naming checks (TS4023) that real Next.js
  // consumers never hit, since app code is not emitted to .d.ts.
  //
  // tests/dist-consumer is a consumer of the *built* package: it resolves
  // `@flefebvre/next-pipe` to `dist`, has its own tsconfig, and is run by
  // `pnpm typecheck:dist`. It must never be compiled against `src`.
  "exclude": ["dist", "node_modules", "tests/fixtures", "tests/dist-consumer"]
}
